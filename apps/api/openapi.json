{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikkit API",
    "description": "Self-hosted IT ticketing API. Product endpoints live under `/api/v1`. Every non-2xx response uses the `ErrorBody` shape; see docs/api.md.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as the web app"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness probe.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The API process is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/live": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness probe (explicit path for orchestrators).",
        "operationId": "getHealthLive",
        "responses": {
          "200": {
            "description": "The API process is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Readiness probe. Unlike other endpoints, a 503 here carries the\n`Readiness` body (not `ErrorBody`) so orchestrators and operators can see\nwhich check failed.",
        "operationId": "getHealthReady",
        "responses": {
          "200": {
            "description": "Database reachable and schema compatible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "A required dependency is not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "The OpenAPI document of this API.",
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs in with username and password. Always creates a new session; a\nsession cookie sent with the request is revoked (session fixation\ndefence). Unknown usernames, wrong passwords and deactivated accounts get\nthe same `401 invalid_credentials`.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in; sets the session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_credentials`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`csrf_rejected`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`rate_limited` (see `Retry-After`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs out: revokes the presented session server-side and clears the\ncookie. Idempotent (204 without a session too).",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Signed out; clears the session cookie"
          },
          "403": {
            "description": "`csrf_rejected`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The current session. This is the source of truth for the signed-in UI\nstate (e.g. after a page refresh).",
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated` (an invalid cookie is cleared)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ]
      }
    },
    "/api/v1/setup": {
      "get": {
        "tags": [
          "setup"
        ],
        "summary": "Whether first setup is still open.",
        "operationId": "getSetupStatus",
        "responses": {
          "200": {
            "description": "Setup state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "setup"
        ],
        "summary": "Creates the initial Admin account and signs it in. One-time: after it\nsucceeded (or concurrently with a winning attempt) it answers `409\nsetup_completed`. All later accounts require an invitation.",
        "operationId": "completeSetup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Admin created and signed in; sets the session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`csrf_rejected`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`setup_completed`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`rate_limited` (see `Retry-After`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Account": {
        "type": "object",
        "description": "The signed-in account's own view of itself.",
        "required": [
          "id",
          "username",
          "displayName",
          "email",
          "role",
          "specialization",
          "language",
          "status",
          "team",
          "createdAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "description": "Contact address only; not unique and never used to identify accounts."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "specialization": {
            "type": [
              "string",
              "null"
            ],
            "description": "Specialist field designation; grants no access."
          },
          "status": {
            "$ref": "#/components/schemas/AccountStatus"
          },
          "team": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AccountTeam",
                "description": "The current team membership, `null` when the account has no team."
              }
            ]
          },
          "username": {
            "type": "string",
            "description": "As entered at creation (trimmed); login compares the normalized form."
          }
        }
      },
      "AccountStatus": {
        "type": "string",
        "description": "Account lifecycle status.",
        "enum": [
          "active",
          "deactivated"
        ]
      },
      "AccountTeam": {
        "type": "object",
        "required": [
          "id",
          "name",
          "isLead"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "isLead": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "AdminAccount": {
        "type": "object",
        "description": "Admin view of an account. Accounts are identified by `id` and `username`;\n`email` is contact information only and may be shared by several accounts.",
        "required": [
          "id",
          "username",
          "displayName",
          "email",
          "role",
          "specialization",
          "language",
          "status",
          "team",
          "createdAt",
          "updatedAt",
          "deactivatedAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "deactivatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "specialization": {
            "type": [
              "string",
              "null"
            ],
            "description": "Display designation (Specialists). Grants no access."
          },
          "status": {
            "$ref": "#/components/schemas/AccountStatus"
          },
          "team": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AccountTeam"
              }
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "AssignmentQueue": {
        "type": "string",
        "description": "Where a ticket currently is, as shown to its requester.",
        "enum": [
          "general_queue",
          "team"
        ]
      },
      "DatabaseCheck": {
        "type": "string",
        "enum": [
          "ok",
          "unavailable"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "description": "Response body wrapper for every error: `{\"error\": {...}}`.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable, language-independent error codes. Serialized as snake_case.\n\nAdding a variant is a contract change: update `openapi.json`\n(`UPDATE_OPENAPI=1 cargo test --locked -p tikkit-api openapi`), regenerate\nthe web client and add English and German messages in\n`apps/web/src/api/errors.ts` (the TypeScript build fails until you do).",
        "enum": [
          "invalid_request",
          "validation_failed",
          "unauthenticated",
          "forbidden",
          "csrf_rejected",
          "not_found",
          "method_not_allowed",
          "conflict",
          "invalid_credentials",
          "setup_completed",
          "last_admin",
          "team_membership_conflict",
          "team_lead_required",
          "team_has_open_tickets",
          "payload_too_large",
          "rate_limited",
          "internal_error",
          "service_unavailable"
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "message": {
            "type": "string",
            "description": "Safe English fallback message. Never contains internal details."
          },
          "requestId": {
            "type": "string",
            "description": "Same value as the `x-request-id` response header."
          }
        }
      },
      "FieldError": {
        "type": "object",
        "description": "One invalid field. `field` uses the request's camelCase names with `.`\nfor nesting and `[n]` for array items (e.g. `screenshots[0].name`).",
        "required": [
          "field",
          "code"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/FieldErrorCode"
          },
          "field": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "description": "Interpolation values for the translated message (e.g. `{\"min\": 3}`).",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "FieldErrorCode": {
        "type": "string",
        "description": "Stable per-field validation codes. Serialized as snake_case.",
        "enum": [
          "required",
          "too_short",
          "too_long",
          "out_of_range",
          "invalid_format",
          "invalid_value",
          "invalid_type",
          "unknown_field",
          "already_taken"
        ]
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok` while the process serves requests.",
            "example": "ok"
          }
        }
      },
      "Language": {
        "type": "string",
        "description": "Interface/notification language. English is the fallback. A language\nchoice never influences authorization or business rules.",
        "enum": [
          "en",
          "de"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PublicAssignee": {
        "type": "object",
        "required": [
          "displayName"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          }
        }
      },
      "PublicTeam": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "PublicTicketAssignment": {
        "type": "object",
        "description": "Public assignment details for requester-facing ticket responses.\n\nDeliberately contains only display values: no team/account ids,\nusernames, emails, or roles. `team` and `assignee` are always present and\n`null` when not set, so \"general queue\" and \"unassigned\" are explicit.",
        "required": [
          "queue",
          "team",
          "assignee"
        ],
        "properties": {
          "assignee": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PublicAssignee"
              }
            ]
          },
          "queue": {
            "$ref": "#/components/schemas/AssignmentQueue"
          },
          "team": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PublicTeam"
              }
            ]
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "status": {
            "type": "string",
            "description": "`ready` or `not_ready`.",
            "example": "ready"
          }
        }
      },
      "ReadinessChecks": {
        "type": "object",
        "required": [
          "database",
          "schema"
        ],
        "properties": {
          "database": {
            "$ref": "#/components/schemas/DatabaseCheck"
          },
          "schema": {
            "$ref": "#/components/schemas/SchemaCheck"
          }
        }
      },
      "Role": {
        "type": "string",
        "description": "Account role. Exactly one per account; see spec.md \"Roles\".",
        "enum": [
          "user",
          "operator",
          "specialist",
          "team_lead",
          "admin"
        ]
      },
      "SchemaCheck": {
        "type": "string",
        "enum": [
          "ok",
          "pending_migrations",
          "incompatible",
          "unknown"
        ]
      },
      "SessionInfo": {
        "type": "object",
        "description": "The current session: who is signed in and until when.",
        "required": [
          "account",
          "expiresAt"
        ],
        "properties": {
          "account": {
            "$ref": "#/components/schemas/Account"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Absolute expiry of the session (UTC). The session also ends after 12\nhours without activity."
          }
        }
      },
      "SetupRequest": {
        "type": "object",
        "required": [
          "username",
          "displayName",
          "email",
          "password",
          "language"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "description": "Contact address; not unique."
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "password": {
            "type": "string",
            "description": "12–256 characters, not equal to the username."
          },
          "username": {
            "type": "string",
            "description": "3–32 characters of `[a-z0-9._-]` after trimming, NFKC normalization\nand lowercasing. Stored as entered (trimmed) for display."
          }
        },
        "additionalProperties": false
      },
      "SetupStatus": {
        "type": "object",
        "required": [
          "setupRequired"
        ],
        "properties": {
          "setupRequired": {
            "type": "boolean",
            "description": "`true` until the initial Admin has been created. Never becomes `true`\nagain."
          }
        }
      },
      "Team": {
        "type": "object",
        "description": "Admin view of a team with its designated lead and current members\n(ordered by username). Archived teams have no lead and no members.",
        "required": [
          "id",
          "name",
          "status",
          "lead",
          "members",
          "createdAt",
          "archivedAt"
        ],
        "properties": {
          "archivedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "lead": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TeamPerson"
              }
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TeamMember"
            }
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TeamStatus"
          }
        }
      },
      "TeamMember": {
        "type": "object",
        "description": "A current member (including the lead).",
        "required": [
          "id",
          "username",
          "displayName",
          "role",
          "specialization",
          "status",
          "isLead",
          "memberSince"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "isLead": {
            "type": "boolean"
          },
          "memberSince": {
            "type": "string",
            "format": "date-time"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "specialization": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/AccountStatus"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "TeamPerson": {
        "type": "object",
        "description": "Compact account reference (lead).",
        "required": [
          "id",
          "username",
          "displayName"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "TeamStatus": {
        "type": "string",
        "enum": [
          "active",
          "archived"
        ]
      }
    },
    "securitySchemes": {
      "session_cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "tikkit_session",
        "description": "HttpOnly session cookie set by setup/login. Named `__Host-tikkit_session` in production."
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Health and API metadata"
    },
    {
      "name": "setup",
      "description": "One-time first setup (initial Admin)"
    },
    {
      "name": "auth",
      "description": "Login, logout and the current session. Unsafe requests need `Origin: <PUBLIC_ORIGIN>`."
    }
  ]
}
