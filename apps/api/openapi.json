{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikkit API",
    "description": "Conventions: docs/api-conventions.md. Errors use the ErrorEnvelope schema; lists use `limit`/`cursor` and return a Page. Authentication is the HttpOnly `tikkit_session` cookie; every POST/PUT/PATCH/DELETE must send `X-Requested-With: tikkit` or is rejected with 403 `csrf_rejected` (docs/auth.md).",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "1"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs in with username and password. Every failure is the same\n`invalid_credentials`, whether the account is unknown, deactivated, or the password wrong.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in; a new session cookie is set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_credentials`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "`rate_limited`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Revokes the current session and clears the cookie. Idempotent.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Signed out; cookie cleared"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The signed-in account.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "`unauthorized`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Changes the password, revokes every session of this account, and issues a fresh one.",
        "operationId": "change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Password changed; new session cookie set"
          },
          "401": {
            "description": "`unauthorized`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed` (`current_password: incorrect`, `new_password: too_short|too_long|too_common`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "`rate_limited`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Liveness: the process is serving. Touches no dependencies.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "This OpenAPI document.",
        "operationId": "openapi_json",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Readiness: the database answers and its schema matches this build.\nReports stable check identifiers only, never connection details.",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Ready to serve traffic",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "A required dependency is unavailable or incompatible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/api/setup": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Whether first-admin setup is still open.",
        "operationId": "setup_status",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Creates the first Admin and signs them in. Works exactly once per deployment.",
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Admin created; session cookie set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "409": {
            "description": "`setup_already_completed`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "`rate_limited`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Account": {
        "type": "object",
        "description": "Account of the current session.",
        "required": [
          "id",
          "username",
          "display_name",
          "email",
          "role",
          "language"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "description": "Contact address only; never identifies an account."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string",
            "description": "12-256 characters."
          }
        },
        "additionalProperties": false
      },
      "Checks": {
        "type": "object",
        "required": [
          "database",
          "migrations"
        ],
        "properties": {
          "database": {
            "type": "string",
            "description": "`ok` or `unavailable`."
          },
          "migrations": {
            "type": "string",
            "description": "`ok`, `pending`, `incompatible`, or `unknown`."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "details": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ErrorDetails"
              }
            ]
          },
          "message": {
            "type": "string",
            "description": "Safe English fallback text; translate by `code` instead of showing this."
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable machine-readable error codes. Never translated; clients map them to text.",
        "enum": [
          "validation_failed",
          "invalid_json",
          "unknown_field",
          "invalid_identifier",
          "invalid_query",
          "bad_request",
          "unsupported_media_type",
          "unauthorized",
          "invalid_credentials",
          "csrf_rejected",
          "rate_limited",
          "setup_already_completed",
          "forbidden",
          "not_found",
          "method_not_allowed",
          "conflict",
          "payload_too_large",
          "internal"
        ]
      },
      "ErrorDetails": {
        "type": "object",
        "required": [
          "fields"
        ],
        "properties": {
          "fields": {
            "type": "object",
            "description": "Invalid input fields (dotted paths) and their stable error codes.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          },
          "request_id": {
            "type": "string",
            "description": "Same value as the `x-request-id` response header."
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Language": {
        "type": "string",
        "description": "Machine identifiers published in the contract; display text is localized by clients.",
        "enum": [
          "en",
          "de"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Page_TicketAssignmentView": {
        "type": "object",
        "description": "One page of a list. `next_cursor` is null on the last page.",
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Public handling details shown to a ticket's requester. `team_name: null`\nmeans the shared general queue; `assignee_display_name: null` means unassigned.",
              "required": [
                "team_name",
                "assignee_display_name"
              ],
              "properties": {
                "assignee_display_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "team_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/Checks"
          },
          "status": {
            "type": "string",
            "description": "`ready` or `unavailable`."
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "user",
          "operator",
          "specialist",
          "team_lead",
          "admin"
        ]
      },
      "SetupRequest": {
        "type": "object",
        "required": [
          "username",
          "email",
          "password",
          "language"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "password": {
            "type": "string",
            "description": "12-256 characters."
          },
          "username": {
            "type": "string",
            "description": "3-64 characters: letters, digits, `.`, `_`, `-`. Case-insensitive."
          }
        },
        "additionalProperties": false
      },
      "SetupStatus": {
        "type": "object",
        "required": [
          "setup_required"
        ],
        "properties": {
          "setup_required": {
            "type": "boolean"
          }
        }
      },
      "TicketAssignmentView": {
        "type": "object",
        "description": "Public handling details shown to a ticket's requester. `team_name: null`\nmeans the shared general queue; `assignee_display_name: null` means unassigned.",
        "required": [
          "team_name",
          "assignee_display_name"
        ],
        "properties": {
          "assignee_display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "team_name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "TicketStatus": {
        "type": "string",
        "enum": [
          "draft",
          "ai_processing",
          "awaiting_ai_decision",
          "queued",
          "in_progress",
          "waiting_for_requester",
          "awaiting_confirmation",
          "closed",
          "cancelled",
          "ai_solved"
        ]
      }
    }
  }
}
