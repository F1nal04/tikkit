{
  "openapi": "3.1.0",
  "info": {
    "title": "Tikkit API",
    "description": "Self-hosted IT ticketing API. Product endpoints live under `/api/v1`. Every non-2xx response uses the `ErrorBody` shape; see docs/api.md.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as the web app"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness probe.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The API process is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/live": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness probe (explicit path for orchestrators).",
        "operationId": "getHealthLive",
        "responses": {
          "200": {
            "description": "The API process is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Readiness probe. Unlike other endpoints, a 503 here carries the\n`Readiness` body (not `ErrorBody`) so orchestrators and operators can see\nwhich check failed.",
        "operationId": "getHealthReady",
        "responses": {
          "200": {
            "description": "Database reachable and schema compatible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "A required dependency is not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "The OpenAPI document of this API.",
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssignmentQueue": {
        "type": "string",
        "description": "Where a ticket currently is, as shown to its requester.",
        "enum": [
          "general_queue",
          "team"
        ]
      },
      "DatabaseCheck": {
        "type": "string",
        "enum": [
          "ok",
          "unavailable"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "description": "Response body wrapper for every error: `{\"error\": {...}}`.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable, language-independent error codes. Serialized as snake_case.\n\nAdding a variant is a contract change: update `openapi.json`\n(`UPDATE_OPENAPI=1 cargo test --locked -p tikkit-api openapi`), regenerate\nthe web client and add English and German messages in\n`apps/web/src/api/errors.ts` (the TypeScript build fails until you do).",
        "enum": [
          "invalid_request",
          "validation_failed",
          "unauthenticated",
          "forbidden",
          "csrf_rejected",
          "not_found",
          "method_not_allowed",
          "conflict",
          "payload_too_large",
          "rate_limited",
          "internal_error",
          "service_unavailable"
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "message": {
            "type": "string",
            "description": "Safe English fallback message. Never contains internal details."
          },
          "requestId": {
            "type": "string",
            "description": "Same value as the `x-request-id` response header."
          }
        }
      },
      "FieldError": {
        "type": "object",
        "description": "One invalid field. `field` uses the request's camelCase names with `.`\nfor nesting and `[n]` for array items (e.g. `screenshots[0].name`).",
        "required": [
          "field",
          "code"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/FieldErrorCode"
          },
          "field": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "description": "Interpolation values for the translated message (e.g. `{\"min\": 3}`).",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "FieldErrorCode": {
        "type": "string",
        "description": "Stable per-field validation codes. Serialized as snake_case.",
        "enum": [
          "required",
          "too_short",
          "too_long",
          "out_of_range",
          "invalid_format",
          "invalid_value",
          "invalid_type",
          "unknown_field",
          "already_taken"
        ]
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok` while the process serves requests.",
            "example": "ok"
          }
        }
      },
      "Language": {
        "type": "string",
        "description": "Interface/notification language. English is the fallback. A language\nchoice never influences authorization or business rules.",
        "enum": [
          "en",
          "de"
        ]
      },
      "PublicAssignee": {
        "type": "object",
        "required": [
          "displayName"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          }
        }
      },
      "PublicTeam": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "PublicTicketAssignment": {
        "type": "object",
        "description": "Public assignment details for requester-facing ticket responses.\n\nDeliberately contains only display values: no team/account ids,\nusernames, emails, or roles. `team` and `assignee` are always present and\n`null` when not set, so \"general queue\" and \"unassigned\" are explicit.",
        "required": [
          "queue",
          "team",
          "assignee"
        ],
        "properties": {
          "assignee": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PublicAssignee"
              }
            ]
          },
          "queue": {
            "$ref": "#/components/schemas/AssignmentQueue"
          },
          "team": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PublicTeam"
              }
            ]
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "status": {
            "type": "string",
            "description": "`ready` or `not_ready`.",
            "example": "ready"
          }
        }
      },
      "ReadinessChecks": {
        "type": "object",
        "required": [
          "database",
          "schema"
        ],
        "properties": {
          "database": {
            "$ref": "#/components/schemas/DatabaseCheck"
          },
          "schema": {
            "$ref": "#/components/schemas/SchemaCheck"
          }
        }
      },
      "SchemaCheck": {
        "type": "string",
        "enum": [
          "ok",
          "pending_migrations",
          "incompatible",
          "unknown"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Health and API metadata"
    }
  ]
}
