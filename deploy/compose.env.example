# Production environment for the Tikkit Docker Compose deployment.
#
#   cp deploy/compose.env.example deploy/compose.env   # keep compose.env out of Git
#   chmod 600 deploy/compose.env
#
# Replace every CHANGE_ME value. The API refuses to start in production while
# a required value is missing, malformed, or still a placeholder, and
# `tikkit-api check-config` prints a redacted summary to verify a file:
#
#   docker compose --env-file deploy/compose.env run --rm api tikkit-api check-config
#
# AI providers and SMTP are optional and configured later by an Admin in the
# UI; nothing here is needed for them, and the service starts with both off.
# The full production Compose file is tracked separately (issue #46).

# --- Public entry point -------------------------------------------------------
# The https origin users open (scheme + host [+ port], no path). Must match
# what the TLS reverse proxy serves; also used for CSRF origin checks.
PUBLIC_ORIGIN=https://help.example.com

# --- Runtime mode ------------------------------------------------------------
TIKKIT_ENV=production
RUST_LOG=info,sqlx=warn

# --- Internal service addresses (private Compose network) ---------------------
# The API listens on all interfaces inside its container; only the reverse
# proxy publishes ports. Do not publish the API or database ports on the host.
API_ADDR=0.0.0.0:3001
# Address of the API as seen by the reverse proxy (routes /api/* here).
TIKKIT_API_UPSTREAM=api:3001
# Address of the web frontend as seen by the reverse proxy.
TIKKIT_WEB_UPSTREAM=web:3000
# Only enable when the reverse proxy sets X-Forwarded-For and clients cannot
# reach the API directly.
TRUST_PROXY_HEADERS=true

# --- PostgreSQL 16 -----------------------------------------------------------
# Used by the postgres service to initialise the database on first start.
POSTGRES_USER=tikkit
POSTGRES_DB=tikkit
# Generate with: openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=CHANGE_ME
# Must repeat the credentials above; `db` is the database service name on the
# private network. Percent-encode special characters in the password.
DATABASE_URL=postgres://tikkit:CHANGE_ME@db:5432/tikkit
DATABASE_MAX_CONNECTIONS=10
# Apply migrations automatically on start. Set to false to run
# `tikkit-api migrate` as an explicit upgrade step instead.
DATABASE_AUTO_MIGRATE=true
DATABASE_STARTUP_TIMEOUT_SECS=60

# --- Secrets -----------------------------------------------------------------
# Encrypts stored AI and SMTP credentials. Generate once and keep a copy in
# your secret store, separate from database backups:
#   openssl rand -base64 32
# Losing it makes stored provider/SMTP credentials unrecoverable.
TIKKIT_ENCRYPTION_KEY=CHANGE_ME

# --- Lifecycle ---------------------------------------------------------------
# Seconds to drain in-flight requests after SIGTERM. Keep below the Compose
# stop_grace_period (default 10s; set it to e.g. 30s).
SHUTDOWN_TIMEOUT_SECS=20
