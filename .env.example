# Copy to .env (git-ignored) for development. The API loads it from the repository
# root; real environment variables take precedence. See docs/configuration.md.
# Placeholders below are deliberately invalid: generate your own values.

ENVIRONMENT=development
DATABASE_URL=postgres://tikkit:tikkit@127.0.0.1:5432/tikkit
API_ADDR=127.0.0.1:3001
PUBLIC_ORIGIN=http://localhost:3000
# Generate each with: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_openssl_rand_base64_32
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32
SHUTDOWN_TIMEOUT_SECS=20
SESSION_TTL_HOURS=336
SESSION_ROTATE_HOURS=24
# Only `true` behind a reverse proxy that overwrites X-Forwarded-For (the production compose does).
TRUST_PROXY_HEADERS=false
# Outbound mail is not configured here. An Admin saves the SMTP connection in the app
# (/admin/email). The password is encrypted with ENCRYPTION_KEY.
# Private screenshot storage (absolute path on a persistent volume in production).
SCREENSHOT_DIR=data/screenshots

# Integration tests create and drop throwaway databases through this connection.
TEST_DATABASE_URL=postgres://tikkit:tikkit@127.0.0.1:5432/tikkit
