# Tikkit API configuration for local development. Every value here is
# optional in development; the API does not read this file itself. To use it:
#
#   cp .env.example .env        # .env is ignored by Git
#   set -a; . ./.env; set +a    # export into your shell, then `bun run dev`
#
# See docs/configuration.md for every variable and the production rules.
# Production examples live in deploy/compose.env.example.

# development (default) or production
TIKKIT_ENV=development

# PostgreSQL 16. Unset in development = this value (compose.dev.yml).
DATABASE_URL=postgres://tikkit:tikkit@127.0.0.1:5432/tikkit
# DATABASE_MAX_CONNECTIONS=10
# DATABASE_AUTO_MIGRATE=true
# DATABASE_STARTUP_TIMEOUT_SECS=30

# API listen address; the Vite dev proxy expects 127.0.0.1:3001.
# API_ADDR=127.0.0.1:3001

# Origin users open in the browser. Unset in development = http://localhost:3000.
# PUBLIC_ORIGIN=http://localhost:3000

# Optional in development, required in production. Generate with:
#   openssl rand -base64 32
# TIKKIT_ENCRYPTION_KEY=

# SHUTDOWN_TIMEOUT_SECS=20
# TRUST_PROXY_HEADERS=false
# RUST_LOG=info,sqlx=warn

# Integration tests (cargo test) create disposable databases on this server.
# TEST_DATABASE_URL=postgres://tikkit:tikkit@127.0.0.1:5432/postgres
