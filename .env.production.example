# Copy to .env.production (git-ignored, owner-only). Read docs/deployment.md.
# Compose derives the API's PUBLIC_ORIGIN as https://<PUBLIC_HOST>.
# Use a lowercase hostname with no scheme, path, or default :443 suffix.
PUBLIC_HOST=help.example.com
# Independent release tags. Replace VERSION with a released version, or use
# complete image references pinned by digest.
TIKKIT_WEB_IMAGE=ghcr.io/f1nal04/tikkit-web:web-vVERSION
TIKKIT_API_IMAGE=ghcr.io/f1nal04/tikkit-api:api-vVERSION

# Generate each database password independently with: openssl rand -hex 32
# Keep TIKKIT_DB_PASSWORD URL-safe (hex).
POSTGRES_PASSWORD=
TIKKIT_DB_PASSWORD=
# Generate each key independently with: openssl rand -base64 32
SESSION_SECRET=
ENCRYPTION_KEY=

# The proxy is the only published service. For a nondefault HTTPS port, include it in PUBLIC_HOST.
# PROXY_BIND=0.0.0.0
# HTTP_PORT=80
# HTTPS_PORT=443

# For an isolated test only, use Caddy's internal CA (see deployment guide).
# CADDY_GLOBAL_OPTIONS=local_certs
