{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "dist/**"]
    },
    "check": {},
    "test": {},
    "start": { "cache": false, "persistent": true },
    "@tikkit/web#check": { "dependsOn": ["build"] },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["CI", "E2E_DATABASE_URL", "PW_CHROMIUM_PATH", "PLAYWRIGHT_*", "CARGO_*", "RUSTUP_*"]
    },
    "@tikkit/api#dev": {
      "cache": false,
      "persistent": true,
      "env": ["API_ADDR"]
    },
    "@tikkit/api#build": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/Cargo.toml", "$TURBO_ROOT$/Cargo.lock"]
    },
    "@tikkit/api#check": { "cache": false },
    "@tikkit/api#test": { "cache": false },
    "@tikkit/api#start": {
      "cache": false,
      "persistent": true,
      "env": ["API_ADDR"]
    },
    "@tikkit/web#start": {
      "cache": false,
      "persistent": true,
      "env": ["HOST", "PORT"]
    }
  }
}
