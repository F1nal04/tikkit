{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", ".svelte-kit/**"]
    },
    "check": {},
    "test": {},
    "start": { "cache": false, "persistent": true },
    "@tikkit/api#dev": {
      "cache": false,
      "persistent": true,
      "env": ["API_ADDR", "DATABASE_URL"]
    },
    "@tikkit/api#build": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/Cargo.toml", "$TURBO_ROOT$/Cargo.lock"]
    },
    "@tikkit/api#check": { "cache": false },
    "@tikkit/api#test": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "TEST_DATABASE_URL"]
    },
    "@tikkit/api#start": {
      "cache": false,
      "persistent": true,
      "env": ["API_ADDR", "DATABASE_URL"]
    },
    "@tikkit/web#start": {
      "cache": false,
      "persistent": true,
      "env": ["HOST", "PORT", "API_ORIGIN", "ORIGIN", "PROTOCOL_HEADER", "HOST_HEADER", "XFF_DEPTH"]
    }
  }
}
