{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "dist/**"]
    },
    "check": {},
    "test": {},
    "start": { "cache": false, "persistent": true },
    "@tikkit/web#check": { "dependsOn": ["build"] },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["CI", "E2E_DATABASE_URL", "PW_CHROMIUM_PATH", "PLAYWRIGHT_*", "CARGO_*", "RUSTUP_*"]
    },
    "@tikkit/api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_ADDR",
        "DATABASE_*",
        "PUBLIC_ORIGIN",
        "TIKKIT_*",
        "SHUTDOWN_TIMEOUT_SECS",
        "TRUST_PROXY_HEADERS",
        "RUST_LOG"
      ]
    },
    "@tikkit/api#build": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/Cargo.toml", "$TURBO_ROOT$/Cargo.lock"]
    },
    "@tikkit/api#check": { "cache": false },
    "@tikkit/api#test": {
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL", "RUST_LOG"]
    },
    "@tikkit/api#start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_ADDR",
        "DATABASE_*",
        "PUBLIC_ORIGIN",
        "TIKKIT_*",
        "SHUTDOWN_TIMEOUT_SECS",
        "TRUST_PROXY_HEADERS",
        "RUST_LOG"
      ]
    },
    "@tikkit/web#start": {
      "cache": false,
      "persistent": true,
      "env": ["HOST", "PORT"]
    }
  }
}
